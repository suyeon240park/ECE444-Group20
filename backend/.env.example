# Copy to backend/.env for local development. Never commit backend/.env.

# development | production
FLASK_ENV=development

# PostgreSQL connection string. Empty is fine for sprint 1; nothing reads it yet.
# Matches the database started by `docker compose up db` at the repository root.
DATABASE_URL=postgresql://wimf:wimf@localhost:5432/wimf

# Vision-model label extraction prototype (#16). Get a key at https://aistudio.google.com/apikey;
# never commit it. VISION_MODEL must be a current vision-capable Gemini model name.
GEMINI_API_KEY=
VISION_MODEL=gemini-3.5-flash
VISION_TIMEOUT_SECONDS=60
# Paid-tier prices in USD per million tokens, from https://ai.google.dev/pricing. Only
# used to report cost per photo; leave empty to skip.
VISION_PRICE_INPUT_PER_MTOK=
VISION_PRICE_OUTPUT_PER_MTOK=

# Comma-separated origins allowed to call the API. "*" is fine in development.
CORS_ORIGINS=*

# Set by the deployment (#22) so /api/health can report the running commit.
GIT_COMMIT=dev
