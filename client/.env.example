# Copy to client/.env for local development. Never commit client/.env.
#
# Where the client finds the backend. Leave it out (or keep localhost) when testing
# in the browser. When testing on a phone with Expo Go, use your computer's LAN IP,
# e.g. http://192.168.1.23:5000, and start the backend with --host 0.0.0.0.
# Only variables prefixed EXPO_PUBLIC_ are visible to the app.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Set by the staging build from Render's RENDER_GIT_COMMIT (#22) and shown as
# "App build ..." on the home screen. Leave it out locally; the app shows "dev".
# EXPO_PUBLIC_GIT_COMMIT=
